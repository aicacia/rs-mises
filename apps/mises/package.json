{
	"name": "mises",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"desktop:dev": "tauri dev",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint . && prettier --check .",
		"lint:fix": "prettier --write . && eslint --fix .",
		"proto": "grpc_tools_node_protoc --ts_proto_out=./src/lib/proto/ --ts_proto_opt=env=browser,outputServices=nice-grpc,outputServices=generic-definitions,outputJsonMethods=false,useExactTypes=false --proto_path=../../crates/proto/proto/ ../../crates/proto/proto/mises.proto",
		"postinstall": "svelte-kit sync"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.13.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.53.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.1",
		"@tauri-apps/cli": "^2.10.1",
		"@types/node": "^25.3.3",
		"eslint": "^10.0.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.0",
		"globals": "^17.4.0",
		"grpc-tools": "^1.13.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.53.7",
		"svelte-check": "^4.4.4",
		"tailwindcss": "^4.2.1",
		"ts-proto": "^2.11.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.1",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^1.0.0"
	},
	"dependencies": {
		"@aicacia/debounce": "^0.1.25",
		"@aicacia/svelte-forms": "^0.1.0",
		"@aicacia/svelte-headless": "workspace:*",
		"@aicacia/oidc-client": "workspace:*",
		"@aicacia/trycatch": "^0.1.2",
		"@bufbuild/protobuf": "^2.11.0",
		"@lucide/svelte": "^0.575.0",
		"@tauri-apps/api": "^2.10.1",
		"@tauri-apps/plugin-deep-link": "^2.4.7",
		"@tauri-apps/plugin-log": "^2.8.0",
		"@tauri-apps/plugin-opener": "^2.5.3",
		"nice-grpc-common": "^2.0.2",
		"nice-grpc-web": "^3.3.9",
		"valibot": "^1.2.0"
	}
}