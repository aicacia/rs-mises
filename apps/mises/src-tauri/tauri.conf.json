{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "mises",
	"version": "0.1.0",
	"identifier": "com.mises",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:5173",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "M.I.S.E.S",
				"width": 800,
				"height": 600
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"deep-link": {
			"mobile": [
				{
					"scheme": ["mises"],
					"appLink": false
				}
			],
			"desktop": {
				"schemes": ["mises"]
			}
		},
		"cli": {
			"description": "A Tauri app with CLI arguments",
			"args": [
				{
					"name": "config",
					"short": "c",
					"takesValue": true,
					"description": "The config path to use"
				}
			]
		}
	}
}
