{
	"name": "@aicacia/db-example",
	"version": "0.0.0",
	"private": true,
	"description": "Example usage of Aicacia DB, a local first database for JavaScript and TypeScript applications.",
	"type": "module",
	"module": "esm/index.js",
	"main": "cjs/index.js",
	"types": "types/index.d.ts",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"buildCJS": "tsc -b tsconfig.cjs.json",
		"buildESM": "tsc",
		"buildBrowser": "rollup -c",
		"doc": "typedoc",
		"prepublishOnly": "pnpm run build",
		"test": "node --loader ts-node/esm node_modules/tape/bin/tape src/**/*.test.{ts,tsx} | tap-spec",
		"coverage": "nyc --reporter=lcov --check-coverage --lines=75 --require ts-node/register tape src/**/*.test.{ts,tsx} | tap-spec; nyc report ---reporter=text",
		"coverageHTML": "nyc --reporter=lcov --check-coverage --lines=75 --require ts-node/register tape src/**/*.test.{ts,tsx} | tap-spec; nyc report ---reporter=html",
		"clean": "shx rm -rf esm cjs browser types .nyc_output coverage",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "prettier --write . && eslint --fix .",
		"preCommit": "pnpm run lint:fix && pnpm run coverage",
		"prepare": "husky"
	},
	"husky": {
		"hooks": {
			"pre-commit": "pnpm run preCommit"
		}
	},
	"dependencies": {
		"@aicacia/db": "workspace:*",
		"@standard-schema/spec": "^1.1.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^10.0.1",
		"@rollup/plugin-commonjs": "^29.0.1",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^0.4.4",
		"@rollup/plugin-typescript": "^12.3.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/benchmark": "^2.1.5",
		"@types/tape": "^5.8.1",
		"benchmark": "^2.1.4",
		"eslint": "^9.39.3",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.4.0",
		"husky": "^9.1.7",
		"nyc": "^17.1.0",
		"prettier": "^3.8.1",
		"rollup": "^4.59.0",
		"rollup-plugin-esm-import-to-url": "^2.1.0",
		"shx": "^0.4.0",
		"svelte": "^5.53.7",
		"tap-nyc": "^1.0.3",
		"tap-spec": "^5.0.0",
		"tape": "^5.9.0",
		"ts-node": "^10.9.2",
		"tslib": "^2.8.1",
		"typedoc": "^0.28.17",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.1",
		"vite": "^7.3.1"
	},
	"peerDependencies": {
		"tslib": "2"
	},
	"nyc": {
		"include": [
			"src"
		],
		"exclude": [
			"src/**/*.test.*"
		],
		"extension": [
			".ts",
			".tsx"
		]
	}
}